# --- Backend ---
DATABASE_URL=postgresql+psycopg://careerprep:careerprep@localhost:5432/careerprep
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@careerprep.com
ADMIN_PASSWORD=Admin@12345

# --- Job notification crawler (Apify) ---
# Leave empty to disable live job sync; the admin "Sync jobs" button will report
# that no token is configured. Get a token from https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Max items requested per source per sync. Apify FREE plans cap actor previews at 25.
APIFY_MAX_ITEMS=25
# Seconds to wait for one actor run before giving up.
APIFY_RUN_TIMEOUT_SECONDS=420

# --- CORS / Env ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# --- Email (optional; forgot-password returns token in dev mode when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@careerprep.local

# --- Frontend ---
VITE_API_BASE_URL=/api
# In production this must include the /api prefix, e.g.
# VITE_API_BASE_URL=https://careerprep-api.onrender.com/api

# --- Production deployment (Vercel + Render + Neon) ---
# The seed + table creation run automatically on backend startup, so a fresh
# Neon database just needs its connection string here. Artifacts live at:
#   backend/Dockerfile, render.yaml (Render blueprint), frontend/vercel.json
